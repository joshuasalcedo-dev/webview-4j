{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": {
      "@webview4j/ui/*": ["../../../core/src/main/ui/src/*"],
      "@webview4j/api": ["../../../core/src/main/typescript/index.ts"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  },
  "include": ["src", "../../../core/src/main/ui/src/vite.d.ts", "../../../core/src/main/ui/src/css.d.ts"]
}
