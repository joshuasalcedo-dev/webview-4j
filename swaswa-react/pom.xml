<?xml version="1.0" encoding="UTF-8"?>
<!--
  swaswa-react: real React components in a view's page, used from Java as components (create, set, add): their props
  typed, their events back as Java events, a value the person changes kept in Java. React itself is in the jar
  (src/main/resources/.../react-runtime.js, made by src/build: bun install && bun run build): no Node for an app.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.joshuasalcedo.swaswa</groupId>
        <artifactId>swaswa-parent</artifactId>
        <version>0.1.1</version>
    </parent>

    <artifactId>swaswa-react</artifactId>
    <name>swaswa-react</name>
    <description>Real React components from Java: typed props, events back, values kept in Java.</description>

    <dependencies>
        <dependency>
            <groupId>io.joshuasalcedo.swaswa</groupId>
            <artifactId>swaswa-ffi</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                    <environmentVariables>
                        <SWASWA_BROWSER>off</SWASWA_BROWSER>
                    </environmentVariables>
                    <systemPropertyVariables>
                        <swaswa.webview.data>${project.build.directory}/webview-profile/tests</swaswa.webview.data>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
