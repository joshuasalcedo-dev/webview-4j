<?xml version="1.0" encoding="UTF-8"?>
<!--
  swaswa-shadcn: shadcn/ui's components from Java, typed (a class per component, generated from its TypeScript props),
  drawn by React in the page (swaswa-react). The components, their CSS and their classes are made by src/build
  (bun build.ts; to add a component, run shadcn add in src/build/ui first) and committed.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.joshuasalcedo.swaswa</groupId>
        <artifactId>swaswa-parent</artifactId>
        <version>0.1.1</version>
    </parent>

    <artifactId>swaswa-shadcn</artifactId>
    <name>swaswa-shadcn</name>
    <description>shadcn/ui from Java: its components, typed, drawn by React in the page.</description>

    <dependencies>
        <dependency>
            <groupId>io.joshuasalcedo.swaswa</groupId>
            <artifactId>swaswa-react</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                    <environmentVariables>
                        <SWASWA_BROWSER>off</SWASWA_BROWSER>
                    </environmentVariables>
                    <systemPropertyVariables>
                        <swaswa.webview.data>${project.build.directory}/webview-profile/tests</swaswa.webview.data>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
