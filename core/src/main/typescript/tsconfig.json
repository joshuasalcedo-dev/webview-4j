{
  "compilerOptions": {
    // The package runs in a webview page: browser types, no Bun globals (tests reference those themselves).
    "lib": ["ESNext", "DOM"],
    "types": [],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["*.ts"],
  "exclude": ["dist", "node_modules"]
}
